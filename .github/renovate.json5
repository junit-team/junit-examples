{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>junit-team/renovate-config',
  ],
  platformAutomerge: true,
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/^junit-jupiter-starter-ant/Ant\\.java$/'],
      matchStrings: [
        '\\s*String version = "(?<currentValue>[^"]+)";',
      ],
      datasourceTemplate: 'maven',
      depNameTemplate: 'org.apache.ant:ant',
      versioningTemplate: 'maven',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^junit-jupiter-starter-ant/build\\.xml$/'],
      matchStrings: [
        '\\s*<property name="ivy.install.version" value="(?<currentValue>[^"]+)"\\/>',
      ],
      datasourceTemplate: 'maven',
      depNameTemplate: 'org.apache.ivy:ivy',
      versioningTemplate: 'maven',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/.+\\.ya?ml$/'],
      matchStrings: [
        "develocity-plugin-version: '(?<currentValue>[^']+)'",
      ],
      datasourceTemplate: 'gradle-plugin',
      depNameTemplate: 'com.gradle.develocity',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/.+\\.ya?ml$/'],
      matchStrings: [
        "develocity-ccud-plugin-version: '(?<currentValue>[^']+)'",
      ],
      datasourceTemplate: 'gradle-plugin',
      depNameTemplate: 'com.gradle.common-custom-user-data-gradle-plugin',
    }
  ],
}
